<div id="container-base">
<div class="container-fluid px-5">
  <div class="row g-4 mt-2">
    <% @movies.each do |movie| %>
      <% if movie.poster != "N/A" %>
        <div class="col-md-6 col-lg-4 col-xl-3 mb-3">
          <div class="card shadow-sm h-100 card-movie interactive-card border-0">
            <div class="row g-0 align-items-center">

              <div class="col-4">
                <img 
                  src="<%= movie.poster %>" 
                  class="img-fluid rounded-start"
                  style="height: 180px; width: 100%; object-fit: cover;"
                  alt="<%= movie.title %>">
              </div>

              <div class="col-8">
                <div class="card-body p-3">

                  <h6 class="card-title mb-1 fw-bold">
                    <%= movie.title %>
                  </h6>
                  
                  <div class="mb-2">
                    <span class="genre-badge">
                      <i class="bi bi-tags-fill me-1"></i><%= format_text(movie) %>
                    </span>
                  </div>

                  <div class="d-flex flex-column gap-1">
                    <small class="text-muted d-flex align-items-center">
                      <i class="bi bi-calendar3 me-2 text-secondary"></i>
                      <%= movie.year %>
                    </small>

                    <small class="text-muted d-flex align-items-center">
                      <i class="bi bi-person-bounding-box me-2 text-secondary"></i>
                      Adulto: <strong class="ms-1 <%= movie.adult ? 'text-danger' : 'text-success' %>"><%= movie.adult ? "Sim" : "Não" %></strong>
                    </small>

                    <small class="text-dark d-flex align-items-center fw-bold">
                      <i class="bi bi-star-fill me-2 text-warning"></i>
                      <%= movie.vote_average %> <span class="text-muted fw-normal ms-1">/ 10</span>
                    </small>
                  </div>
                  
                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
<p> Data provided by TMDb </p>