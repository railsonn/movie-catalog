<div id="container-base">
  <div class="container-fluid px-5 py-4">

    <div class="row g-4 mt-2">
      <% @movies_genres.each do |genre| %>

        <div class="col-md-6 col-lg-4 col-xl-3">
          <%= link_to categories_show_path(genre: genre), class: "text-decoration-none" do %>

            <div class="card category-card d-flex align-items-center justify-content-center text-center">
              <div class="card-body">
                <h4 class="category-title m-0">
                <% binding.irb %>
                  <%= genre %>
                </h4>
              </div>
            </div>

          <% end %>
        </div>

      <% end %>
    </div>

  </div>
</div>



<p> Data provided by TMDb </p>  