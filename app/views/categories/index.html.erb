<div id="container-base">
  <div class="container-fluid px-5 py-4">

    <div class="row g-4 mt-2">
      <% @movies_genres.each do |genre| %>

        <div class="col-md-6 col-lg-4 col-xl-3">
          <%= link_to categories_show_path(genre: genre), class: "text-decoration-none" do %>

            <div class="card category-card text-center">
              <div class="card-body d-flex flex-column justify-content-center align-items-center">

                <div class="category-icon mb-3">
                  🎬
                </div>

                <h4 class="category-title m-0">
                  <%= genre %>
                </h4>

                <div class="category-line mt-3"></div>

              </div>
            </div>

          <% end %>
        </div>

      <% end %>
    </div>

  </div>
</div>


<p> Data provided by TMDb </p>  