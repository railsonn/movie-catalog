<div id="container-base">
<div class="container-fluid px-5">
  <div class="row g-4 mt-2">
    <% @movies_genres.each do |movie| %>

      <%= link_to categories_show_path(genre: movie), class: "text-decoration-none text-dark" do %>
                <div class="card-body p-3">
                  <h2><%= movie %></h2>
                </div>
      <% end %>
    <% end %>
  </div>
</div>




<p> Data provided by TMDb </p>  