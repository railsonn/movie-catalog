<% content_for :title, "Movies" %>

<div class="container mt-4 movies-page">

  <div class="d-flex align-items-center mb-4 position-relative movies-header">

    <div class="position-absolute end-0 top-0">
      <%= link_to "Home", root_path, class: "btn btn-success shadow-sm fw-semibold" %>
    </div>

    <h1 class="mx-auto text-light fw-bold display-6">
      Lista de Filmes
    </h1>

  </div>

  <% if notice %>
    <div class="alert alert-success shadow-sm border-0 rounded-3">
      <%= notice %>
    </div>
  <% end %>

  <% if @movies.any? %>
    <div class="row g-4">

      <% @movies.each do |movie| %>
        <div class="col-md-6 col-lg-4">

          <div class="card h-100 shadow-lg movie-card">

            <div class="card-body d-flex gap-3 align-items-start">
              <% if movie.poster != "N/A" %>
                <img
                  src="<%= movie.poster %>"
                  alt="<%= movie.title %>"
                  class="img-fluid movie-poster"
                  style="width: 120px; object-fit: cover;"
                >
              <% end %>

              <div class="flex-grow-1">

                  <h6 class="card-title mb-1 fw-bold">
                    <%= movie.title %>
                  </h6>
                  
                  <div class="mb-2">
                    <span class="genre-badge">
                      <i class="bi bi-tags-fill me-1"></i><%= format_text(movie) %>
                    </span>
                  </div>

                  <div class="d-flex flex-column gap-1">
                    <small class="text-muted d-flex align-items-center">
                      <i class="bi bi-calendar3 me-2 text-secondary"></i>
                      <%= movie.year %>
                    </small>

                    <small class="text-muted d-flex align-items-center">
                      <i class="bi bi-person-bounding-box me-2 text-secondary"></i>
                      Adulto: <strong class="ms-1 <%= movie.adult ? 'text-danger' : 'text-success' %>"><%= movie.adult ? "Sim" : "Não" %></strong>
                    </small>

                    <small class="text-dark d-flex align-items-center fw-bold">
                      <i class="bi bi-star-fill me-2 text-warning"></i>
                      <%= movie.vote_average %> <span class="text-muted fw-normal ms-1">/ 10</span>
                    </small>
                  </div>

              </div>
            </div>
          </div>
        </div>
      <% end %>

      <div class="d-flex mt-5 justify-content-center gap-3 pagination-area">

        <% if params[:page].to_i > 1 %>
          <%= link_to "← Anterior",
            movies_path(q: params[:q], page: params[:page].to_i - 1),
            class: "btn btn-outline-light px-4 fw-medium" %>
        <% else %>
          <div></div>
        <% end %>

        <% if @next_movies.size > 5 %>
          <%= link_to "Próxima →",
            movies_path(q: params[:q], page: (params[:page].to_i.zero? ? 2 : params[:page].to_i + 1)),
            class: "btn btn-outline-light px-4 fw-medium" %>
        <% end %>

      </div>
    </div>

  <% else %>
    <p class="text-center text-light fs-5 mt-5">
      Filme nao encontrado.
    </p>
  <% end %>
  
</div>
