<% content_for :title, "Movies" %>

<div class="container mt-4 movies-page">

  <div class="d-flex align-items-center mb-4 position-relative movies-header">

    <div class="position-absolute end-10 top-0" style="right: 150px;">
      <%= link_to "Home", root_path, class: "btn btn-success shadow-sm fw-semibold" %>
    </div>

    <div class="position-absolute end-0 top-0">
      <%= link_to "Add New Movie", new_movie_path, class: "btn btn-success shadow-sm fw-semibold" %>
    </div>

    <h1 class="mx-auto text-light fw-bold display-6">
      Lista de Filmes
    </h1>

  </div>

  <% if notice %>
    <div class="alert alert-success shadow-sm border-0 rounded-3">
      <%= notice %>
    </div>
  <% end %>

  <% if @movies.any? %>
    <div class="row g-4">

      <% @movies.each do |movie| %>
        <div class="col-md-6 col-lg-4">

          <div class="card h-100 shadow-lg movie-card">

            <div class="card-body d-flex gap-3 align-items-start">

              <% if movie["Poster"] != "N/A" %>
                <img
                  src="<%= movie["Poster"] %>"
                  alt="<%= movie["Title"] %>"
                  class="img-fluid movie-poster"
                  style="width: 120px; object-fit: cover;"
                >
              <% end %>

              <div class="flex-grow-1">

                <h5 class="card-title mb-2 fw-semibold text-light">
                  <%= movie["Title"] %>
                </h5>

                <div class="mb-2">
                  <small class="me-2 text-uppercase fw-medium text-success">
                    <%= movie["Type"] %>
                  </small>

                  <% if movie["Rated"].present? %>
                    <small class="text-muted">
                      • <%= movie["Rated"] %>
                    </small>
                  <% end %>
                </div>

                <div>
                  <% if movie["Runtime"].present? %>
                    <span class="badge bg-success bg-opacity-75 me-2 px-3 py-2">
                      <%= movie["Runtime"] %>
                    </span>
                  <% end %>

                  <% if movie["Year"].present? %>
                    <span class="badge bg-dark border border-success text-light px-3 py-2">
                      <%= movie["Year"] %>
                    </span>
                  <% end %>
                </div>

              </div>
            </div>

            <div class="card-footer bg-transparent border-0 d-flex gap-2">
            </div>

          </div>
        </div>
      <% end %>

      <div class="d-flex mt-5 justify-content-center gap-3 pagination-area">

        <% if params[:page].to_i > 1 %>
          <%= link_to "← Anterior",
            movies_path(q: params[:q], page: params[:page].to_i - 1),
            class: "btn btn-outline-light px-4 fw-medium" %>
        <% end %>

        <%= link_to "Próxima →",
          movies_path(q: params[:q], page: (params[:page].to_i.zero? ? 2 : params[:page].to_i + 1)),
          class: "btn btn-outline-light px-4 fw-medium" %>

      </div>

    </div>

  <% else %>
    <p class="text-center text-muted fs-5 mt-5">
      Nenhum filme cadastrado ainda.
    </p>
  <% end %>

</div>
