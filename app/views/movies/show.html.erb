<% content_for :title, "Movies" %>

<div class="container mt-4 movies-page">

  <div class="d-flex align-items-center mb-4 position-relative movies-header">

    <div class="position-absolute end-10 top-0" style="right: 150px;">
      <%= link_to "Home", root_path, class: "btn btn-success shadow-sm fw-semibold" %>
    </div>

    <div class="position-absolute end-0 top-0">
      <%= link_to "Add New Movie", new_movie_path, class: "btn btn-success shadow-sm fw-semibold" %>
    </div>

    <h1 class="mx-auto text-light fw-bold display-6">
      Filme
    </h1>

  </div>

  <% if notice %>
    <div class="alert alert-success shadow-sm border-0 rounded-3">
      <%= notice %>
    </div>
  <% end %>

  <% if @movie.present? %>

    <div class="row justify-content-center">

      <% Array(@movie).each do |movie| %>

      <div class="col-md-10 col-lg-8">

        <div class="card shadow-lg movie-card p-3">

          <div class="card-body d-flex gap-4 align-items-start">

            <% if movie.poster != "N/A" %>
              <img
                src="<%= movie.poster %>"
                alt="<%= movie.title %>"
                class="img-fluid movie-poster"
                style="width: 200px; object-fit: cover;"
              >
            <% end %>

            <div class="flex-grow-1">

              <h3 class="card-title mb-3 fw-bold">
                <%= movie.title %>
              </h3>

              <div class="d-flex flex-column gap-2 fs-5">

                <small class="text-muted d-flex align-items-center">
                  <i class="bi bi-calendar3 me-2 text-secondary"></i>
                  <%= movie.year %>
                </small>

                <small class="text-muted d-flex align-items-center">
                  <i class="bi bi-person-bounding-box me-2 text-secondary"></i>
                  Adulto:
                  <strong class="ms-1 <%= movie.adult ? 'text-danger' : 'text-success' %>">
                    <%= movie.adult ? "Sim" : "Não" %>
                  </strong>
                </small>

                <small class="text-dark d-flex align-items-center fw-bold">
                  <i class="bi bi-star-fill me-2 text-warning"></i>
                  <%= movie.vote_average %>
                  <span class="text-muted fw-normal ms-1">/ 10</span>
                </small>

              </div>

            </div>

          </div>

        </div>

      </div>

      <% end %>

    </div>

  <% else %>

    <p class="text-center text-light fs-5 mt-5">
      Filme nao encontrado.
    </p>

  <% end %>

</div>