<div id="container-base">
  <div class="container">
    <div class="row g-3">
      <% @movies.each do |movie| %>
        <% if movie.poster != "N/A" %>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">
              <div class="d-flex align-items-center p-3 gap-3">
                <img
                  src="<%= movie.poster %>"
                  alt="<%= movie.title %>"
                  class="img-fluid rounded"
                  style="width: 90px; object-fit: cover;"
                >

                <div>
                  <h6 class="mb-1 fw-semibold">
                    <%= movie.title %>
                  </h6>
                  <small class="me-2 text-uppercase fw-medium text-success">
                    <%= movie.movie_type %>
                  </small><br>
                  <small class="badge bg-dark border border-success text-light px-3 py-2">
                    <%= movie.year %>
                  </small><br>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="d-flex mt-5 justify-content-center gap-3 pagination-area">
      <% if params[:page].to_i > 1 %>
        <%= link_to "← Anterior",
          root_path(q: params[:q], page: params[:page].to_i - 1),
          class: "btn btn-outline-light px-4 fw-medium" %>
      <% else %>
        <div></div>
      <% end %>

      <% if @next_movies.size > 5 %>
        <%= link_to "Próxima →",
          root_path(q: params[:q], page: (params[:page].to_i.zero? ? 2 : params[:page].to_i + 1)),
          class: "btn btn-outline-light px-4 fw-medium" %>
      <% end %>
    </div>
  </div>
</div>