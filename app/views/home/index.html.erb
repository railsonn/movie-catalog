<div class="alert alert-success mt-3">
  Bootstrap funcionando 🎉
</div>




<% @movies.each do |movie| %>
  <div class="card mb-3">
    <% if movie["Poster"] != "N/A" %>
      <img src="<%= movie["Poster"] %>" width="120">
    <% end %>

    <div>
      <h5><%= movie["Title"] %></h5>
      <small><%= movie["Year"] %></small>
    </div>
  </div>
<% end %>


<div class="d-flex justify-content-between mt-4">
  <% if params[:page].to_i > 1 %>
    <%= link_to "← Anterior", root_path(q: params[:q], page: params[:page].to_i - 1),
      class: "btn btn-outline-secondary" %>
  <% end %>

  <%= link_to "Próxima →", root_path(q: params[:q], page: (params[:page].to_i.zero? ? 2 : params[:page].to_i + 1)),
    class: "btn btn-outline-secondary" %>
</div>
