<div id="container-base">
  <div class="container-fluid px-5">
    <div class="row g-4 mt-2">
      <% @movies.each do |movie| %>
        <% if movie.poster != "N/A" %>
          <div class="col-md-6 col-lg-4 col-xl-3 mb-3">
            <div class="card shadow-sm h-100 card-movie">
              <div class="row g-0 align-items-center">

                <!-- IMAGEM MENOR -->
                <div class="col-4">
                  <img 
                    src="<%= movie.poster %>" 
                    class="img-fluid rounded-start"
                    style="height: 180px; object-fit: cover;"
                    alt="<%= movie.title %>">
                </div>

                <!-- CONTEÚDO MAIS COMPACTO -->
                <div class="col-8">
                  <div class="card-body p-2">

                    <h6 class="card-title mb-1 fw-bold">
                      <%= movie.title %>
                    </h6>

                    <span class="badge bg-success text-uppercase mb-1">
                      <%= format_text(movie) %>
                    </span>

                    <div>
                      <small class="text-muted">
                        <%= movie.year %>
                      </small>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="d-flex mt-5 justify-content-center gap-3 pagination-area">
      <% if params[:page].to_i > 1 %>
        <%= link_to "← Anterior",
          root_path(q: params[:q], page: params[:page].to_i - 1),
          class: "btn btn-outline-light px-4 fw-medium" %>
      <% else %>
        <div></div>
      <% end %>

      <% if @next_movies.size > 5 %>
        <%= link_to "Próxima →",
          root_path(q: params[:q], page: (params[:page].to_i.zero? ? 2 : params[:page].to_i + 1)),
          class: "btn btn-outline-light px-4 fw-medium" %>
      <% end %>
    </div>
  </div>
</div>

<p> Data provided by TMDb </p>